      "fixture_cpp": "#include \"meshoptimizer.h\"\n#include <algorithm>\n#include <array>\n#include <cassert>\n#include <cstdio>\n#include <vector>\nusing Tri = std::array<unsigned,3>;\nint main() {\n    constexpr unsigned side = 12;\n    std::vector<float> pos;\n    std::vector<unsigned> indices;\n    for (unsigned z=0; z<side; ++z) for (unsigned x=0; x<side; ++x) {\n        pos.insert(pos.end(), {float(x), float((x*z)%7), float(z)});\n        if (z+1<side && x+1<side) {\n            unsigned a=z*side+x;\n            indices.insert(indices.end(), {a,a+1,a+side, a+1,a+side+1,a+side});\n        }\n    }\n    std::vector<unsigned> reordered(indices.size());\n    meshopt_optimizeOverdraw(reordered.data(),indices.data(),indices.size(),pos.data(),pos.size()/3,12,1.05f);\n    auto tris=[](const std::vector<unsigned>& v) {\n        std::vector<Tri> ts;\n        for (size_t i=0; i<v.size(); i+=3) ts.push_back({v[i],v[i+1],v[i+2]});\n        std::sort(ts.begin(),ts.end()); return ts;\n    };\n    assert(tris(indices)==tris(reordered));\n    size_t bound=meshopt_buildMeshletsBound(indices.size(),32,32);\n    std::vector<meshopt_Meshlet> meshes(bound);\n    std::vector<unsigned> vertices(indices.size());\n    std::vector<unsigned char> triangles(indices.size());\n    size_t n=meshopt_buildMeshlets(meshes.data(),vertices.data(),triangles.data(),indices.data(),indices.size(),pos.data(),pos.size()/3,12,32,32,0.5f);\n    std::vector<unsigned> reconstructed;\n    for (size_t m=0;m<n;++m) {\n        const auto& mesh=meshes[m]; assert(mesh.vertex_count<=32 && mesh.triangle_count<=32);\n        for (unsigned t=0;t<mesh.triangle_count*3;++t) {\n            unsigned idx=triangles[mesh.triangle_offset+t]; assert(idx<mesh.vertex_count);\n            reconstructed.push_back(vertices[mesh.vertex_offset+idx]);\n        }\n    }\n    assert(tris(indices)==tris(reconstructed));\n    std::printf(\"vertices=%zu triangles=%zu meshlets=%zu overdraw_order_changed=%d oriented_triangles_preserved=1 max_meshlet_vertices=32 max_meshlet_triangles=32\\n\",pos.size()/3,indices.size()/3,n,indices!=reordered);\n}\n",
