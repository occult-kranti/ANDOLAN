# Local agent job receipts, cooperative locks and recoverable quarantine.
/.local-swarm/

# Reproducible external research checkouts and isolated tool installs.
/.local-tools/

# Editor-generated IDs for source checks/capture tools (tracked IDs stay tracked).
/games/yuga-native/tests/**/*.gd.uid
/games/yuga-native/tools/**/*.gd.uid

# Supplied reference media and private capture state stay local; receipts remain versioned.
