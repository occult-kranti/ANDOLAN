  "sampling_contract": {
    "time": "Absolute seconds clamped to[0,24]; every visible state derives from that time.",
    "motion": "Per-actor keys interpolate position linearly and yaw by shortest angular path; endpoints hold.",
    "actions": "Half-open intervals[start,start+duration); final24s samples last endpoint. Map action0..1 to clip0..length. Ready fills gaps; no additive unbounded root motion.",
    "camera": "Blend from previous segment endpoint camera to current segment target during blend_seconds after t_seconds; previous segment target is held before cut. First segment and final endpoint hold.",
    "cues": "Visible only during declared half-open interval; deterministic effect phase=(t-start)/duration, no accumulated random state.",
    "receipts": "UI health derives from latest applicable receipt at time<=t; receipts never mutate gameplay simulation.",
    "audio": "Seek shared24s mix to absolute time; seeking/restart does not stack independentcue players.",
    "restart": "Reset absolute time and all derivedstate; repeatedseek tosame time produces same pose/cues/camera/health."
  },
