", false, 200, `{\"models\":[{\"name\":\"other:latest\",\"context_length\":32768}]}`, 0},\n+\t} {\n+\t\tt.Run(tt.name, func(t *testing.T) {\n+\t\t\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n+\t\t\t\tswitch r.URL.Path {\n+\t\t\t\tcase \"/api/generate\":\n+\t\t\t\t\tvar req api.GenerateRequest\n+\t\t\t\t\tif err := json.NewDecoder(r.Body).Decode(&req); err != nil || req.Model != \"local\" || req.Prompt != \"\" || len(req.Options) != 0 {\n+\t\t\t\t\t\tt.Errorf(\"expected load-only request without option overrides: %+v, %v\", req, err)\n+\t\t\t\t\t}\n+\t\t\t\t\tif tt.loadError {\n+\t\t\t\t\t\tw.WriteHeader(http.StatusInternalServerError)\n+\t\t\t\t\t\tfmt.Fprintln(w, `{\"error\":\"model requires more system memory\"}`)\n+\t\t\t\t\t\treturn\n+\t\t\t\t\t}\n+\t\t\t\t\tfmt.Fprintln(w, `{\"done\":true,\"done_reason\":\"load\"}`)\n+\t\t\t\tcase \"/api/ps\":\n+\t\t\t\t\tif tt.loadError {\n+\t\t\t\t\t\tt.Error(\"looked up context after a failed load\")\n+\t\t\t\t\t}\n+\t\t\t\t\tw.WriteHeader(tt.status)\n+\t\t\t\t\tfmt.Fprint(w, tt.processes)\n+\t\t\t\tdefault:\n+\t\t\t\t\tt.Errorf(\"unexpected request: %s\", r.URL.Path)\n+\t\t\t\t\thttp.NotFound(w, r)\n+\t\t\t\t}\n+\t\t\t}))\n+\t\t\tdefer srv.Close()\n+\t\t\tt.Setenv(\"OLLAMA_HOST\", srv.URL)\n+\t\t\tlength, err := loadedContextLength(\"local\")\n+\t\t\tif length != tt.wantLength || (err != nil) != tt.loadError {\n+\t\t\t\tt.Fatalf(\"loadedContextLength = %d, %v; want %d, loadError=%v\", length, err, tt.wantLength, tt.loadError)\n+\t\t\t}\n+\t\t\tif tt.loadError && !strings.Contains(err.Error(), \"model requires more system memory\") {\n+\t\t\t\tt.Fatalf(\"load error cause lost: %v\", err)\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestLoadedContextLengthBoundsMetadataWait(t *testing.T) {\n+\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n+\t\tif r.URL.Path == \"/api/generate\" {\n+\t\t\tfmt.Fprintln(w, `{\"done\":true,\"done_reason\":\"load\"}`)\n+\t\t\treturn\n+\t\t}\n+\t\tselect {\n+\t\tcase <-r.Context().Done():\n+\t\tcase <-time.After(10 * time.Second):\n+\t\t\tt.Error(\"optional metadata request was not cancelled promptly\")\n+\t\t}\n+\t}))\n+\tdefer srv.Close()\n+\tt.Setenv(\"OLLAMA_HOST\", srv.URL)\n+\tstarted := time.Now()\n+\tlength, err := loadedContextLength(\"local\")\n+\tif length != 0 || err != nil {\n+\t\tt.Fatalf(\"stalled metadata must allow fallback after successful load: %d, %v\", length, err)\n+\t}\n+\tif elapsed := time.Since(started); elapsed > 10*time.Second {\n+\t\tt.Fatalf(\"optional metadata held up launch for %v\", elapsed)\n+\t}\n+}"},{"sha":"56b028f74029c12b00f23639dc144fb4a1ccd4ff","filename":"cmd/launch/launch.go","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/ollama/ollama/blob/1472203c47d93d64020fdafa33f9b038bc1583e9/cmd%2Flaunch%2Flaunch.go","raw_url":"https://github.com/ollama/ollama/raw/1472203c47d93d64020fdafa33f9b038bc1583e9/cmd%2Flaunch%2Flaunch.go","contents_url":"https://api.github.com/repos/ollama/ollama/contents/cmd%2Flaunch%2Flaunch.go?ref=1472203c47d93d64020fdafa33f9b038bc1583e9","patch":"@@ -789,6 +789,9 @@ func (c *launcherClient) launchEditorIntegration(ctx context.Context, name strin\n \t\tlaunchModels = c.resolveRunModels(ctx, name, models)\n \t}\n \n+\tif name == \"opencode\" && len(req.ExtraArgs) == 0 {\n+\t\tlaunchModels = openCodeRuntimeModels(launchModels, c.recommendations(ctx))\n+\t}\n \treturn launchAfterConfiguration(name, runner, models[0], launchModels, req)\n }\n "},{"sha":"d9a7deaefa2df4cdc52c6262c10924b66f8c92ec","filename":"cmd/launch/muse.go","status":"modified","additions":14,"deletions":7,"changes":21,"blob_url":"https://github.com/ollama/ollama/blob/1472203c47d93d64020fdafa33f9b038bc1583e9/cmd%2Flaunch%2Fmuse.go","raw_url":"https://github.com/ollama/ollama/raw/1472203c47d93d64020fdafa33f9b038bc1583e9/cmd%2Flaunch%2Fmuse.go","contents_url":"https://api.github.com/repos/ollama/ollama/contents/cmd%2Flaunch%2Fmuse.go?ref=1472203c47d93d64020fdafa33f9b038bc1583e9","patch":"@@ -357,26 +357,33 @@ func museApplyLoadedContext(models []LaunchModel) []LaunchModel {\n \n // museLoadedContextLength reports the effective context length of a model as\n // the server loaded it, swappable so tests never touch a live server.\n-var museLoadedContextLength = loadedContextLength\n+var museLoadedContextLength = func(model string) int {\n+\tn, _ := loadedContextLength(model)\n+\treturn n\n+}\n \n // loadedContextLength loads model and reads the running instance's context\n // length from the process list — the size the scheduler actually allocated.\n // An empty generate request is ollama's load-only call: it returns once the\n // model is resident without generating tokens, and the launch pays a load the\n-// first muse request would otherwise pay. Returns 0 when anything fails, and\n-// the caller keeps the inventory value.\n-func loadedContextLength(model string) int {\n+// first inference request would otherwise pay. Load failures return an error;\n+// a successful load with unavailable context metadata returns 0, nil.\n+func loadedContextLength(model string) (int, error) {\n \tclient, err := api.ClientFromEnvironment()\n \tif err != nil {\n-\t\treturn 0\n+\t\treturn 0, err\n \t}\n \n \tctx, cancel := context.WithTimeout(context.Background(), museLoadTimeout)\n \tdefer cancel()\n \tif err := client.Generate(ctx, &api.GenerateRequest{Model: model}, func(api.GenerateResponse) error { return nil }); err != nil {\n-\t\treturn 0\n+\t\treturn 0, err\n \t}\n-\treturn LoadedContextWindow(ctx, client, model)\n+\t// Context metadata is optional; a stalled lookup must not hold up launch\n+\t// for the remainder of a large model's load timeout.\n+\tlookupCtx, cancelLookup := context.WithTimeout(ctx, 5*time.Second)\n+\tdefer cancelLookup()\n+\treturn LoadedContextWindow(lookupCtx, client, model), nil\n }\n \n // museRunModels puts the model being launched first, since muse takes its"},{"sha":"f6c838077352ed3baf1c5362ac2accb7cf0ab8df","filename":"cmd/launch/opencode.go","status":"modified","additions":199,"deletions":1,"changes":200,"blob_url":"https://github.com/ollama/ollama/blob/1472203c47d93d64020fdafa33f9b038bc1583e9/cmd%2Flaunch%2Fopencode.go","raw_url":"https://github.com/ollama/ollama/raw/1472203c47d93d64020fdafa33f9b038bc1583e9/cmd%2Flaunch%2Fopencode.go","contents_url":"https://api.github.com/repos/ollama/ollama/contents/cmd%2Flaunch%2Fopencode.go?ref=1472203c47d93d64020fdafa33f9b038bc1583e9","patch":"@@ -1,15 +1,19 @@\n package launch\n \n import (\n+\t\"context\"\n \t\"encoding/json\"\n+\t\"errors\"\n \t\"fmt\"\n \t\"os\"\n \t\"os/exec\"\n \t\"path/filepath\"\n \t\"runtime\"\n \t\"slices\"\n \t\"strings\"\n+\t\"time\"\n \n+\t\"github.com/charmbracelet/x/ansi\"\n \t\"github.com/ollama/ollama/cmd/internal/fileutil\"\n \t\"github.com/ollama/ollama/envconfig\"\n )\n@@ -55,18 +59,212 @@ func (o *OpenCode) Run(model string, models []LaunchModel, args []string) error\n \tif err != nil {\n \t\treturn err\n \t}\n+\tcontent, err := o.runContent(model, models, args...)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif len(args) == 0 && model != \"\" {\n+\t\tif primary, ok := findLaunchModel(models, model); ok {\n+\t\t\tmodel = primary.Name\n+\t\t}\n+\t\targs = []string{\"--model\", \"ollama/\" + model}\n+\t}\n \n \tcmd := exec.Command(opencodePath, args...)\n \tcmd.Stdin = os.Stdin\n \tcmd.Stdout = os.Stdout\n \tcmd.Stderr = os.Stderr\n \tcmd.Env = os.Environ()\n-\tif content := o.resolveContent(model, models); content != \"\" {\n+\tif content != \"\" {\n \t\tcmd.Env = append(cmd.Env, \"OPENCODE_CONFIG_CONTENT=\"+content)\n \t}\n \treturn cmd.Run()\n }\n \n+var (\n+\topenCodeLoadedContextLength = loadedContextLength\n+\topenCodeReadConfig          = readOpenCodeConfig\n+)\n+\n+// Let OpenCode resolve its configuration layers, including JSONC and project settings.\n+func readOpenCodeConfig() ([]byte, error) {\n+\tpath, ok := findOpenCode()\n+\tif !ok {\n+\t\treturn nil, fmt.Errorf(\"could not find the OpenCode executable\")\n+\t}\n+\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n+\tdefer cancel()\n+\tcmd := exec.CommandContext(ctx, path, \"debug\", \"config\")\n+\t// npm's launcher can leave a child holding the output pipes after cancellation.\n+\tcmd.WaitDelay = time.Second\n+\tdata, err := cmd.Output()\n+\tif ctx.Err() != nil {\n+\t\treturn nil, ctx.Err()\n+\t}\n+\tvar exitErr *exec.ExitError\n+\tif errors.As(err, &exitErr) {\n+\t\tif diagnostic := openCodeConfigDiagnostic(exitErr.Stderr); diagnostic != \"\" {\n+\t\t\terr = fmt.Errorf(\"%w: %s\", err, diagnostic)\n+\t\t}\n+\t\treturn nil, fmt.Errorf(\"%w\\nRun `opencode debug config` for details.\", err)\n+\t}\n+\treturn data, err\n+}\n+\n+// OpenCode's validation messages can echo credentials or the entire JSONC file.\n+// Keep only the config location and issue paths, never messages or input values.\n+func openCodeConfigDiagnostic(stderr []byte) string {\n+\t// Cmd.Output truncates large errors mid-message. A partial rejected value\n+\t// must not be mistaken for a field path; use the recovery command instead.\n+\tif len(stderr) > 16<<10 {\n+\t\treturn \"\"\n+\t}\n+\tlines := strings.Split(ansi.Strip(string(stderr)), \"\\n\")\n+\tfor i, line := range lines {\n+\t\tline = strings.TrimPrefix(strings.TrimSuffix(line, \"\\r\"), \"Error: \")\n+\t\tif path, ok := strings.CutPrefix(line, \"Config file at \"); ok {\n+\t\t\tif path, _, ok := strings.Cut(path, \" is not valid JSON(C)\"); ok {\n+\t\t\t\treturn fmt.Sprintf(\"config file at %q is not valid JSON(C)\", path)\n+\t\t\t}\n+\t\t}\n+\t\trest, ok := strings.CutPrefix(line, \"Configuration is invalid\")\n+\t\tif !ok {\n+\t\t\tcontinue\n+\t\t}\n+\t\tdiagnostic := \"configuration is invalid\"\n+\t\tif path, ok := strings.CutPrefix(rest, \" at \"); ok {\n+\t\t\tpath, _, _ = strings.Cut(path, \": \")\n+\t\t\tdiagnostic += fmt.Sprintf(\" at %q\", path)\n+\t\t}\n+\t\tvar fields []string\n+\t\tfor _, issue := range lines[i+1:] {\n+\t\t\tissue = strings.TrimSuffix(issue, \"\\r\")\n+\t\t\tif !strings.HasPrefix(issue, \"↳ \") {\n+\t\t\t\tbreak\n+\t\t\t}\n+\t\t\t// OpenCode appends a space and the field path, even for root issues\n+\t\t\t// whose path is empty. Preserve that trailing space when parsing.\n+\t\t\tif last := strings.LastIndexByte(issue, ' '); last >= 0 && last < len(issue)-1 {\n+\t\t\t\tfields = append(fields, fmt.Sprintf(\"%q\", issue[last+1:]))\n+\t\t\t}\n+\t\t}\n+\t\tif len(fields) > 0 {\n+\t\t\tdiagnostic += \" (invalid fields: \" + strings.Join(fields, \", \") + \")\"\n+\t\t}\n+\t\treturn diagnostic\n+\t}\n+\treturn \"\"\n+}\n+\n+// runContent refreshes only the selected local model's limits after loading it.\n+// Edit remains metadata-only; other picker entries are not loaded, and their\n+// limits must not inherit the selected model's allocation.\n+func (o *OpenCode) runContent(model string, models []LaunchModel, args ...string) (string, error) {\n+\tcontent := o.resolveContent(model, models)\n+\t// Forwarded arguments may select another model, resume a session, or run a\n+\t// utility. Leave those invocations entirely to OpenCode.\n+\tif len(args) > 0 {\n+\t\treturn content, nil\n+\t}\n+\tprimary, _ := findLaunchModel(models, model)\n+\tif model == \"\" || primary.Remote || isCloudModelName(model) {\n+\t\treturn content, nil\n+\t}\n+\tif primary.Name != \"\" {\n+\t\tmodel = primary.Name\n+\t}\n+\n+\tvar config map[string]any\n+\tif err := json.Unmarshal([]byte(content), &config); err != nil {\n+\t\treturn \"\", err\n+\t}\n+\tproviders, _ := config[\"provider\"].(map[string]any)\n+\tprovider, _ := providers[\"ollama\"].(map[string]any)\n+\tentries, _ := provider[\"models\"].(map[string]any)\n+\tentry, _ := entries[model].(map[string]any)\n+\tif entry == nil {\n+\t\treturn content, nil\n+\t}\n+\n+\tfmt.Fprintf(os.Stderr, \"Loading %s...\\n\", model)\n+\tcontextLength, err := openCodeLoadedContextLength(model)\n+\tif err != nil {\n+\t\treturn \"\", fmt.Errorf(\"could not load %s: %w\", model, err)\n+\t}\n+\tif contextLength < 4 {\n+\t\tfmt.Fprintf(os.Stderr, \"Warning: could not read the context size for %s. Continuing with existing settings; long chats may lose earlier messages.\\n\", model)\n+\t\treturn content, nil\n+\t}\n+\tdata, err := openCodeReadConfig()\n+\tif err != nil {\n+\t\treturn \"\", fmt.Errorf(\"could not read OpenCode configuration: %w\", err)\n+\t}\n+\tvar saved struct {\n+\t\tProvider map[string]struct {\n+\t\t\tModels map[string]struct {\n+\t\t\t\tLimit struct{ Input, Output int }\n+\t\t\t}\n+\t\t}\n+\t}\n+\tif err := json.Unmarshal(data, &saved); err != nil {\n+\t\treturn \"\", fmt.Errorf(\"could not read OpenCode model limits: %w\", err)\n+\t}\n+\t// OpenCode prioritizes input over context for compaction. Override stale\n+\t// input limits too, while keeping a user's smaller limit.\n+\tinput := contextLength\n+\n+\t// Reserve a quarter of the context for output, capped at 8k. Avoid a\n+\t// minimum output budget that could consume a small allocation entirely.\n+\toutput := min(8192, contextLength/4)\n+\tif primary.MaxOutputTokens > 0 {\n+\t\toutput = min(output, primary.MaxOutputTokens)\n+\t}\n+\tfor name, configured := range saved.Provider[\"ollama\"].Models {\n+\t\tif !launchModelMatches(name, model) && !launchModelMatches(model, name) {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif configured.Limit.Input > 0 {\n+\t\t\tinput = min(input, configured.Limit.Input)\n+\t\t}\n+\t\tif configured.Limit.Output > 0 {\n+\t\t\toutput = min(output, configured.Limit.Output)\n+\t\t}\n+\t}\n+\tlimit, _ := entry[\"limit\"].(map[string]any)\n+\tif limit == nil {\n+\t\tlimit = make(map[string]any)\n+\t}\n+\tif known, ok := limit[\"output\"].(float64); ok && known > 0 {\n+\t\toutput = min(output, int(known))\n+\t}\n+\tlimit[\"context\"] = contextLength\n+\tlimit[\"input\"] = input\n+\tlimit[\"output\"] = output\n+\tentry[\"limit\"] = limit\n+\tdata, err = json.Marshal(config)\n+\treturn string(data), err\n+}\n+\n+// openCodeRuntimeModels carries recommended output ceilings to Run after Edit\n+// has built the fallback configuration. Native context metadata remains intact.\n+func openCodeRuntimeModels(models []LaunchModel, recommendations []ModelItem) []LaunchModel {\n+\tmodels = cloneLaunchModels(models)\n+\tfor i := range models {\n+\t\tif models[i].Remote || isCloudModelName(models[i].Name) {\n+\t\t\tcontinue\n+\t\t}\n+\t\tfor _, rec := range recommendations {\n+\t\t\tif launchModelRecommendationKey(models[i].Name) != launchModelRecommendationKey(rec.Name) || rec.MaxOutputTokens <= 0 {\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\tif models[i].MaxOutputTokens <= 0 || rec.MaxOutputTokens < models[i].MaxOutputTokens {\n+\t\t\t\tmodels[i].MaxOutputTokens = rec.MaxOutputTokens\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn models\n+}\n+\n func ensureOpenCodeInstalled() (string, error) {\n \tif opencodePath, ok := findOpenCode(); ok {\n \t\treturn opencodePath, nil"},{"sha":"d4f43af59d834d0e4b35ff3f2faba93bbe4ac97e","filename":"cmd/launch/opencode_context_test.go","status":"added","additions":477,"deletions":0,"changes":477,"blob_url":"https://github.com/ollama/ollama/blob/1472203c47d93d64020fdafa33f9b038bc1583e9/cmd%2Flaunch%2Fopencode_context_test.go","raw_url":"https://github.com/ollama/ollama/raw/1472203c47d93d64020fdafa33f9b038bc1583e9/cmd%2Flaunch%2Fopencode_context_test.go","contents_url":"https://api.github.com/repos/ollama/ollama/contents/cmd%2Flaunch%2Fopencode_context_test.go?ref=1472203c47d93d64020fdafa33f9b038bc1583e9","patch":"@@ -0,0 +1,477 @@\n+package launch\n+\n+import (\n+\t\"context\"\n+\t\"encoding/json\"\n+\t\"errors\"\n+\t\"fmt\"\n+\t\"net/http\"\n+\t\"net/http/httptest\"\n+\t\"os\"\n+\t\"os/exec\"\n+\t\"path/filepath\"\n+\t\"reflect\"\n+\t\"runtime\"\n+\t\"strings\"\n+\t\"testing\"\n+\t\"time\"\n+\n+\t\"github.com/ollama/ollama/api\"\n+)\n+\n+func TestOpenCodeRunContentLoadedContext(t *testing.T) {\n+\tfor _, fromEdit := range []bool{false, true} {\n+\t\tt.Run(map[bool]string{false: \"saved configuration\", true: \"fresh edit\"}[fromEdit], func(t *testing.T) {\n+\t\t\tsetTestHome(t, t.TempDir())\n+\t\t\tmodels := []LaunchModel{\n+\t\t\t\t{Name: \"selected\", ContextLength: 131072, Details: api.ModelDetails{ContextLength: 131072}},\n+\t\t\t\t{Name: \"other\", ContextLength: 65536, MaxOutputTokens: 4096},\n+\t\t\t\t{Name: \"cloud-alias\", Remote: true, ContextLength: 262144, MaxOutputTokens: 32768},\n+\t\t\t}\n+\t\t\to := &OpenCode{}\n+\t\t\tvar loaded []string\n+\t\t\tprevious := openCodeLoadedContextLength\n+\t\t\topenCodeLoadedContextLength = func(name string) (int, error) {\n+\t\t\t\tloaded = append(loaded, name)\n+\t\t\t\treturn 8192, nil\n+\t\t\t}\n+\t\t\tt.Cleanup(func() { openCodeLoadedContextLength = previous })\n+\t\t\tif fromEdit {\n+\t\t\t\tif err := o.Edit(models); err != nil {\n+\t\t\t\t\tt.Fatal(err)\n+\t\t\t\t}\n+\t\t\t\tif len(loaded) != 0 {\n+\t\t\t\t\tt.Fatalf(\"Edit loaded models: %v\", loaded)\n+\t\t\t\t}\n+\t\t\t}\n+\t\t\tbefore := o.resolveContent(\"selected\", models)\n+\t\t\tafter, err := o.runContent(\"selected\", models)\n+\t\t\tif err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif !reflect.DeepEqual(loaded, []string{\"selected\"}) {\n+\t\t\t\tt.Fatalf(\"loaded = %v, want selected only\", loaded)\n+\t\t\t}\n+\t\t\tvar expected, got map[string]any\n+\t\t\tif err := json.Unmarshal([]byte(before), &expected); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tif err := json.Unmarshal([]byte(after), &got); err != nil {\n+\t\t\t\tt.Fatal(err)\n+\t\t\t}\n+\t\t\tentry := expected[\"provider\"].(map[string]any)[\"ollama\"].(map[string]any)[\"models\"].(map[string]any)[\"selected\"].(map[string]any)\n+\t\t\tentry[\"limit\"] = map[string]any{\"context\": float64(8192), \"input\": float64(8192), \"output\": float64(2048)}\n+\t\t\tif !reflect.DeepEqual(got, expected) {\n+\t\t\t\tt.Fatalf(\"runtime config changed beyond selected limits:\\ngot %s\", after)\n+\t\t\t}\n+\t\t\tif models[0].ContextLength != 131072 || models[0].Details.ContextLength != 131072 || o.resolveContent(\"selected\", models) != before {\n+\t\t\t\tt.Fatal(\"runtime limits mutated inventory or cached configuration\")\n+\t\t\t}\n+\t\t})\n+\t}\n+}\n+\n+func TestOpenCodeRunContentSkipsCloud(t *testing.T) {\n+\tsetTestHome(t, t.TempDir())\n+\tprevious := openCodeLoadedContextLength\n+\topenCodeLoadedContextLength = func(name string) (int, error) {\n+\t\tt.Fatalf(\"cloud model %q was loaded locally\", name)\n+\t\treturn 0, nil\n+\t}\n+\tt.Cleanup(func() { openCodeLoadedContextLength = previous })\n+\tfor _, primary := range []LaunchModel{\n+\t\t{Name: \"glm-5:cloud\", ContextLength: 202752, MaxOutputTokens: 131072},\n+\t\t{Name: \"cloud-alias\", Remote: true, ContextLength: 131072, MaxOutputTokens: 8192},\n+\t} {\n+\t\to := &OpenCode{}\n+\t\tmodels := []LaunchModel{primary, {Name: \"local\", ContextLength: 32768}}\n+\t\tbefore := o.resolveContent(primary.Name, models)\n+\t\tafter, err := o.runContent(primary.Name, models)\n+\t\tif err != nil || after != before {\n+\t\t\tt.Fatalf(\"cloud config changed: %s, %v\", after, err)\n+\t\t}\n+\t}\n+}\n+\n+func TestOpenCodeRunContentOutputBudget(t *testing.T) {\n+\tsetTestHome(t, t.TempDir())\n+\tprevious := openCodeLoadedContextLength\n+\tt.Cleanup(func() { openCodeLoadedContextLength = previous })\n+\tfor _, tt := range []struct {\n+\t\tcontext, knownOutput, savedInput, savedOutput, wantInput, wantOutput int\n+\t}{\n+\t\t{1024, 0, 0, 0, 1024, 256},\n+\t\t{2048, 0, 0, 0, 2048, 512},\n+\t\t{16384, 0, 0, 0, 16384, 4096},\n+\t\t{65536, 0, 0, 0, 65536, 8192},\n+\t\t{16384, 1024, 0, 0, 16384, 1024},\n+\t\t{8192, 0, 131072, 0, 8192, 2048},\n+\t\t{8192, 0, 131072, 1024, 8192, 1024},\n+\t\t{8192, 0, 4096, 1024, 4096, 1024},\n+\t\t{8192, 0, 131072, 32768, 8192, 2048},\n+\t} {\n+\t\topenCodeLoadedContextLength = func(string) (int, error) { return tt.context, nil }\n+\t\topenCodeReadConfig = func() ([]byte, error) {\n+\t\t\treturn fmt.Appendf(nil, `{\"provider\":{\"oll