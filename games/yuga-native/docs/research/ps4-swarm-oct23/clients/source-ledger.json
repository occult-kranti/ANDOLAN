  "claims": [
    {
      "id": "A1",
      "claim": "Codex README documents ChatGPT sign-in for Plus, Pro, Business, Edu and Enterprise and a separately configured API-key route. This does not establish this user's exact plan or API balance.",
      "source": "sources/codex-README.md",
      "lines": [
        68,
        72
      ]
    },
    {
      "id": "A2",
      "claim": "Codex login source explicitly recommends device-auth on remote/headless machines and distinguishes saved ChatGPT auth from API-key auth. Re-login clears existing auth before login, so reuse valid login first.",
      "source": "sources/codex-cli-login.rs",
      "lines": [
        121,
        172,
        448,
        510
      ]
    },
    {
      "id": "A3",
      "claim": "Official Anthropic Code Action setup documents separate API-key and OAuth-token alternatives and says Pro/Max users can generate an OAuth token through the supported CLI. This confirms an OAuth route, not this user's entitlements and not API credit equivalence.",
      "source": "sources/claude-action-setup.md",
      "lines": [
        7,
        10
      ]
    },
    {
      "id": "A4",
      "claim": "Kimi Code first-use login offers Kimi Code OAuth device authorization or Kimi Platform API key; account access must be verified separately from a generic chat subscription.",
      "source": "sources/kimi-getting-started.md",
      "lines": [
        82,
        96
      ]
    },
    {
      "id": "A5",
      "claim": "Kimi Remote Control requires paid membership, same account, an awake online local process and vendor relay connectivity; it is not offline and does not install a PS4 control agent.",
      "source": "sources/kimi-remote-control.md",
      "lines": [
        1,
        43,
        72,
        95
      ]
    },
    {
      "id": "A6",
      "claim": "Kimi -p is automatically permissioned despite a manual interactive default; --plan is interactive and cannot be combined with -p.",
      "source": "sources/kimi-command.md",
      "lines": [
        20,
        46,
        114,
        120
      ]
    }
  ],
  "validation": "Public source GETs, existing source hashes and documentation inspection only. No CLI installation/login, subscription verification, SSH/device connection, model request, download or deletion performed.",
  "source_limitations": [
    "Official OpenAI web auth and Claude web authentication docs returned proxy CONNECT 403. GitHub sources supply the bounded claims above.",
    "One large codex cli main.rs response was read to a 120001-byte cap and not retained; the separately retrieved login.rs provides the needed commands.",
    "Current Kimi remote-control doc mentions a region flag while the command-reference page says kimi login has no flags; templates use the shared documented bare kimi login form."
  ],
