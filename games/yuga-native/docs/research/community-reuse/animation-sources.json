      "id": "ANIM-04",
      "title": "ozz-animation0.17.0 two-bone IK and foot IK sample",
      "repository": "https://github.com/guillaumeblanc/ozz-animation",
      "revision": "744eb9d99f606eda849acb0b1204f7a3dc20bca1",
      "revision_kind": "remote HEAD observed2026-10-17;0.17.0 release merge2026-08-01",
      "license": "MIT",
      "decision": "adapt-offline-probe; defer-runtime-port",
      "runtime_adoption": false,
      "specific_use": "Actual source-linked scratch C++ probe verifies full/half/zero correction-weight reach semantics; consult sample ordering for target/pelvis/IK. Native Godot baseline is the first next experiment.",
      "compatibility": "GCC14.2 compiler with-std=c++17 built selected native sources directly. This is not full CMake library build or Godot extension. Upstream CMake>=3.30; cmake absent. No sampled pose/mesh from ozz used.",
      "rights_boundary": "Probe fixture/FK reconstruction adapts upstream MIT test source and keeps license. Source-only API use does not license arbitrary animation datasets. Ozz is not a motion-generation model.",
      "files": [
        {
          "repo": "guillaumeblanc/ozz-animation",
