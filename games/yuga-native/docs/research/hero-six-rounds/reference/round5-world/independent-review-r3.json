  "findings": [
    {
      "id": "FINAL-W1",
      "decision": "accepted",
      "images": [
        "00-cover-avenue.png",
        "00-gallery-underpass.png",
        "02-temple-avenue.png",
        "03-coastal-ghat.png",
        "04-metro-gardens.png"
      ],
      "observation": "Sangam stone now has restrained visible ashlar joints, warm sandstone separates from indigo masses, and facade trims/eaves retain readable silhouettes. The broad swirled stone pattern from R1 and flat face read from R2 are corrected in the new district surfaces.",
      "limit": "The inherited domed lane gate retains its older, stronger stone grain; whole-map material consistency remains polish work."
    },
    {
      "id": "FINAL-W2",
      "decision": "accepted",
      "images": [
        "00-cover-avenue.png",
        "02-temple-avenue.png",
        "03-coastal-ghat.png",
        "05-reed-court.png"
      ],
      "observation": "The cover bands read as clean layered volumes in the reviewed view. Distant facade windows now show their filled dark panels rather than isolated arch fragments.",
      "limit": "Fine distant trim edges still show aliasing at 1280×720. Static views cannot prove absence of temporal shimmer or every unseen geometry conflict."
    },
    {
      "id": "FINAL-W3",
      "decision": "accepted",
      "images": [
        "00-gallery-underpass.png",
        "05-reed-court.png",
        "06-lantern-night.png"
      ],
      "observation": "Gallery underside, passage clearance, cover corners and quiet paving are visually distinct. The cyan ground utility circle remains readable; lantern light gives the night facade a local cue without filling the entire lane with effects.",
      "limit": "Actual collision, rooftop traversal and supported cast surfaces require the separate combat/world tests and OS-input review; screenshots alone do not establish them."
    },
    {
      "id": "FINAL-W4",
      "decision": "accepted with retained quality limits",
      "images": [
        "01-city-overview.png",
        "07-night-overview.png"
      ],
      "observation": "Eight authored central building masses, connecting galleries and repeated boundary facade rhythm are visible in the actual native map. The district has greater architectural hierarchy than R1.",
      "limit": "Broad open exposures, repeated building forms, simple skyline/boundary treatment and sparse environmental props remain. This is an original offline district checkpoint, not a finished commercial map or Deadlock visual parity."
    },
    {
      "id": "FINAL-W5",
      "decision": "accepted with retained UX limits",
      "images": [
        "08-player-scale.png",
        "09-field-shop.png",
        "09-pause-controls.png"
      ],
      "observation": "Actual Rama, allied troops and the new district appear together. Ability names, health, relay/core labels, map and F4 field shop fit the reviewed resolution. The shop shows price/status, vulnerability copy, scroll affordance and a prominent return control. Pause copy and legacy invocation entry remain explicit.",
      "limit": "Large upper-center panels consume much of the aiming corridor. The shop still does not prove purchase, vulnerability or input behavior from pixels; root owns those actual interactions. These captured UI states are staged, not human playtesting."
    }
  ],
