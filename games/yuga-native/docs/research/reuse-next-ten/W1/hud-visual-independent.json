      "idle": 125,
      "returning": 148
    },
    "baseline_summary_logical_height": {
      "idle": 122,
      "returning": 142
    },
    "summary_caveat": "The corrected summary is still taller than baseline at this smallest canvas. The acceptance is a bottom-slab/layout-fit improvement, not a universal reduction in every panel."
  },
