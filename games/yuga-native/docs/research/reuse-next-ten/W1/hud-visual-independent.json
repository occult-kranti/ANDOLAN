  "accepted_deltas": [
    "Compact bottom drawn slab reduces from 98 to 80 logical pixels while retaining 16px key/state and 14px detail fonts.",
    "Real reload/busy and returning disabled states remain legible in reviewed pairs.",
    "The correction restores a 64-logical-pixel map plot and avoids forced narrow traversal columns when the full-width stack is shorter.",
    "Correction actual idle and returning rows fit without clipped text or overlap with bottom cards."
  ],
  "preserved_regression_history": {
    "candidate_r1": "At base960 and scale200, forced side-by-side traversal produced narrow multi-line chunks; plot49.4 was visibly crowded. This prompted the measured stack/minimum-plot correction.",
