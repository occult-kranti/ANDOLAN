+		# This changes only pose timing. The target still falls with the actor,
+		# and the fresh support/footprint guards above remain mandatory.
+		var next_descent:=maxf(0.0,-world_velocity.y)*pending_delta
+		var completion_clearance:=minf(LANDING_PREPARE_HEIGHT_M-LANDING_PREPARE_MAX_EXTENSION_M,extension+next_descent)
+		var preparation_span:=LANDING_PREPARE_HEIGHT_M-completion_clearance
 		var weight:=_smooth((LANDING_PREPARE_HEIGHT_M-clearance)/preparation_span)
 		point.y-=extension*weight
