--- candidate-3a0.gd
+++ rama_motion.gd
@@ -531,6 +531,7 @@
 	# support-relative height; feet are never pulled down to a distant plane.
 	# No extra preparation state is carried into ground admission. The solved
 	# pose naturally becomes the outgoing snapshot of the normal land blend.
+	if not world_velocity.is_finite() or not is_finite(pending_delta) or pending_delta<=0 or pending_delta>.1:return
 	if grounded or traversal!="ground" or locomotion!="fall" or world_velocity.y>0:return
 	if not action.is_empty() or action_stage!="none" or aim_weight>.001:return
 	if descent_support_y.is_empty() or not rig.is_inside_tree() or rig.global_transform!=descent_support_transform:return
@@ -548,12 +549,14 @@
 		var standing_y:=maxf(floor_y,support_y)+rest_globals[foot].origin.y
 		var extension:=clampf(point.y-standing_y,0,LANDING_PREPARE_MAX_EXTENSION_M)
 		if extension<=.001:continue
-		# Reach neutral leg extension before impact: finish when the remaining
-		# body descent is no greater than this foot's bounded extension. The
-		# old zero-clearance endpoint left a raised leg in the outgoing land
-		# snapshot. Both ends retain zero ease slope; the target still falls
