+func _prepare_landing_legs() -> void:
+	# Airborne visual extension only. The target remains at the actor's own
+	# support-relative height; feet are never pulled down to a distant plane.
+	# No extra preparation state is carried into ground admission. The solved
+	# pose naturally becomes the outgoing snapshot of the normal land blend.
+	if grounded or traversal!="ground" or locomotion!="fall" or world_velocity.y>0:return
+	if not action.is_empty() or action_stage!="none" or aim_weight>.001:return
+	if descent_support_y.is_empty() or not rig.is_inside_tree() or rig.global_transform!=descent_support_transform:return
+	for side in ["L","R"]:
+		if not descent_support_y.has(side) or not descent_support_owner.has(side):continue
+		var owner:Node3D=descent_support_owner[side].get_ref()
+		if not is_instance_valid(owner) or not owner.is_inside_tree() or owner.is_queued_for_deletion() or owner.global_transform!=descent_support_owner_transform[side]:continue
+		if not descent_support_shape.has(side) or not _descent_shape_valid(owner,descent_support_shape[side]):continue
+		var foot:=rig.find_bone("foot."+side)
+		var point:Vector3=rig.global_transform*rig.get_bone_global_pose(foot).origin
+		if not descent_support_xz.has(side) or Vector2(point.x,point.z).distance_squared_to(descent_support_xz[side])>1e-10:continue
+		var support_y:float=descent_support_y[side]
+		var clearance:=floor_y-support_y
+		if clearance<0 or clearance>=LANDING_PREPARE_HEIGHT_M:continue
+		var standing_y:=maxf(floor_y,support_y)+rest_globals[foot].origin.y
+		var extension:=clampf(point.y-standing_y,0,LANDING_PREPARE_MAX_EXTENSION_M)
+		if extension<=.001:continue
+		# Reach neutral leg extension before impact: finish when the remaining
+		# body descent is no greater than this foot's bounded extension. The
+		# old zero-clearance endpoint left a raised leg in the outgoing land
+		# snapshot. Both ends retain zero ease slope; the target still falls
+		# with the actor and never becomes an airborne world-space anchor.
+		var preparation_span:=LANDING_PREPARE_HEIGHT_M-extension
+		var weight:=_smooth((LANDING_PREPARE_HEIGHT_M-clearance)/preparation_span)
+		point.y-=extension*weight
+		_solve_leg(side,rig.global_transform.affine_inverse()*point)
+
 func _apply_contact() -> void:
+	_prepare_landing_legs()
 	_protect_transition_floor()
 	var contact_allowed:=transition_age>=transition_duration and grounded and traversal=="ground" and locomotion in ["idle","walk","run","sprint","land"] and action!="death" and not (action=="measured_step" and action_stage!="none")
 	var targets:={}
