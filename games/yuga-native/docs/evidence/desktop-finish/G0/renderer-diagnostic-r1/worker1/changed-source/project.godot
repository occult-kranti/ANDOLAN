; YUGA native foundation — original Confluence exploration and training.
config_version=5

[application]
config/name="YUGA • Confluence"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/description="Explore Confluence's three-lane city and train in the Lanka courtyard."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.045,0.085,0.11,1)
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=1024

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=18.0

[audio]
default_bus_layout=""

[debug]
gdscript/warnings/treat_warnings_as_errors=false

[threading]

worker_pool/max_threads=1
