extends SceneTree
func _initialize()->void:
	var contracts=load("res://scripts/native_contracts.gd").new()
	assert(contracts.load_catalog().ok)
	var descriptor:Dictionary=contracts.descriptor("native-offline-triad")
	assert(descriptor.versions.content==5)
	FileAccess.open("res://tests/fixtures/contracts/native-content5-descriptor.json",FileAccess.WRITE).store_string(JSON.stringify(descriptor,"\t",true)+"\n")
	var receipt:={"godot":Engine.get_version_info().string,"catalog_sha256":FileAccess.get_sha256("res://assets/contracts/native-contracts-v1.json"),"validator_sha256":FileAccess.get_sha256("res://scripts/native_contracts.gd"),"descriptor_sha256":FileAccess.get_sha256("res://tests/fixtures/contracts/native-content5-descriptor.json"),"descriptor":descriptor,"scope":"Revision5 descriptor generated by the unchanged Godot validator before revision6 edits."}
	FileAccess.open("res://docs/evidence/ui-campaign/I1/role06/content-revision6/revision5-derivation.json",FileAccess.WRITE).store_string(JSON.stringify(receipt,"\t")+"\n")
	print(JSON.stringify(receipt))
	quit(0)
